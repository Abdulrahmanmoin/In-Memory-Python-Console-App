# Docker Compose Environment Variables
# Copy this file to .env and fill in the actual values
# NEVER commit .env to version control

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection string for Neon or local PostgreSQL
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://user:password@your-neon-host.neon.tech/todo_db?sslmode=require

# ============================================================================
# Backend Configuration
# ============================================================================
# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000

# Secret keys for JWT and session management (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-generate-with-openssl
JWT_SECRET_KEY=your-jwt-secret-key-here-generate-with-openssl
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI/LLM API Keys
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Environment
ENVIRONMENT=production

# ============================================================================
# Frontend Configuration
# ============================================================================
# Backend API URL (for server-side and client-side requests)
NEXT_PUBLIC_API_URL=http://backend:8000
BACKEND_URL=http://backend:8000

# Better Auth configuration (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-better-auth-secret-here
BETTER_AUTH_URL=http://localhost:3000
